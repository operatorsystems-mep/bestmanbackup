{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/private/(.*)",
      "destination": "/api/blocked"
    },
    {
      "source": "/cards/:file(.*\\.pdf)",
      "destination": "/api/card-file/?file=:file"
    }
  ],
  "functions": {
    "api/card-file.js": {
      "includeFiles": "private/cards/*.pdf"
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "header", "key": "x-forwarded-proto", "value": "http" }],
      "destination": "https://bestmanbackup.com/$1",
      "statusCode": 301
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.bestmanbackup.com" }],
      "destination": "https://bestmanbackup.com/$1",
      "statusCode": 301
    },
    {
      "source": "/guides/best-woman-speech",
      "destination": "/guides/",
      "statusCode": 301
    },
    {
      "source": "/guides/best-woman-speech/",
      "destination": "/guides/",
      "statusCode": 301
    },
    {
      "source": "/refund",
      "destination": "/refunds/",
      "statusCode": 308
    },
    {
      "source": "/refund/",
      "destination": "/refunds/",
      "statusCode": 308
    },
    {
      "source": "/private/:path*",
      "destination": "/api/blocked/",
      "statusCode": 307
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:prefix(.*)/index.html",
      "destination": "/:prefix/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(assets|fonts|downloads)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/downloads/(.*\\.pdf)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/cards/(.*\\.pdf)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/links",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/links/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/thank-you",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/thank-you/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/private/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/social/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/CNAME",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/.nojekyll",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
